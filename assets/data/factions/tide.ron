// Aetherfall faction: The Tidecrown Republic (id "tide").
// Lagoon sea-merchants (Venetian/Byzantine with a Varangian edge). Marines that wade
// deep water, crossbow and pike lines, liquid fire, then ironclads, phasers and the
// hover-flagship Bucentaur. Design notes: docs/design/factions/tide.md.
// Schema: crates/af_data/src/schema.rs. Common pool: assets/data/core/*.ron.
(
    factions: [
        (
            id: "tide",
            name: "The Tidecrown Republic",
            epithet: "Lagoon merchants whose marines walk out of the sea",
            description: "A republic of merchant houses, shipwrights and marines under an elected Doge who wears a crown of coral and copper. Their navigators steered by the stars, so they were first to see that the red star was on no chart; when it fell, their galleys went up the rivers and across the marshes to the crater while other armies looked for a road. Crossbows, pikes, marines and liquid fire, then ironclads, phasers and the gilded Bucentaur. Almost no cavalry and no flyers before the Ascendant Age.",
            color: (0.0, 0.85, 0.85),
            traits: [
                (flag: Amphibious, applies_to: [Foot, Mounted, Tracked]),
                (flag: Marshwalker, applies_to: [Foot]),
            ],
            gather_bonus: [("food", 1.15), ("copper", 1.25)],
            units: [
                // Hearth
                "peasant", "scout_rider", "spearman", "slinger", "archer", "tide_marine",
                // Banner
                "pikeman", "crossbowman", "javelineer", "monk", "mangonel", "ballista",
                "tide_stradiot", "tide_varangian",
                // Starfall
                "halberdier", "arquebusier", "grenadier", "clockwork_automaton", "bombard",
                "tide_siphoneer",
                // Engine
                "engineer", "rifle_squad", "gatling_crew", "steam_tank", "rocket_battery",
                "flak_wagon", "tide_diver", "tide_ironclad",
                // Ascendant
                "shield_trooper", "hover_tank", "gunship", "star_bomber", "plasma_artillery",
                "tide_phaser_marine", "tide_bucentaur",
            ],
            buildings: [
                // Core and economy
                "town_center", "citadel", "house", "manor", "lumber_camp", "mining_camp", "mill",
                "farm", "aether_extractor", "tide_harbor",
                // Military production and research
                "barracks", "archery_range", "siege_workshop", "forge", "temple", "castle",
                "aether_foundry", "tide_arsenal", "engine_works", "laboratory", "starport",
                // Internal defence
                "anti_air_battery", "shield_generator",
                // Walls, gates, towers (whole chains)
                "palisade_wall", "palisade_gate", "stone_wall", "stone_gate", "reinforced_wall",
                "reinforced_gate", "force_wall", "force_gate",
                "watchtower", "guard_tower", "bombard_tower", "gun_turret", "plasma_turret",
                "tide_siphon_tower",
            ],
            techs: [
                // Age-ups
                "to_banner", "to_starfall", "to_engine", "to_ascendant",
                // Economy
                "double_bit_axe", "horse_collar", "stone_mining", "prospecting", "bow_saw",
                "heavy_plow", "wheelbarrow", "crop_rotation", "handcart", "deep_shafts",
                "aether_resonance", "steam_harvesters", "adamant_cutting",
                // Forge
                "forging", "fletching", "scale_mail", "aether_tempering", "rifled_barrels",
                "plate_armor", "steam_hammers", "smokeless_powder", "ballistic_weave",
                "star_forged_arms", "adamant_weave",
                // Construction
                "masonry", "architecture", "ferroconcrete", "force_lattice",
                // Line upgrades and military buildings
                "pike_drill", "crossbow_drill", "halberd_drill", "hand_cannon_drill",
                "herbal_medicine", "star_tithe", "ballistics", "conscription", "aether_infusion",
                // Engine and Ascendant
                "analytical_engine", "targeting_computers", "punch_card_logistics",
                "assembly_line", "deflector_shields", "adamant_plating", "fusion_cores",
                // Tidecrown
                "tide_drift_nets", "tide_boarding_drill", "tide_levant_convoys", "tide_pavises",
                "tide_murano_glass", "tide_liquid_fire", "tide_varangian_oath",
                "tide_copper_sheathing", "tide_marriage_of_the_sea",
            ],
            worker: "peasant",
            start: (
                resources: {"food": 300, "wood": 300, "stone": 150, "copper": 100},
                units: [("peasant", 5), ("scout_rider", 1)],
                buildings: ["town_center"],
            ),
            bonuses: [
                "Foot, mounted and tracked units wade deep water",
                "Foot troops cross marsh at full speed",
                "Food +15% and copper +25% gathering",
                "Harbours (up to three): fishing quays and a drop site for food, wood and copper",
                "Liquid fire: siphon crews and siphon towers",
            ],
            ai: (
                aggression: 0.45,
