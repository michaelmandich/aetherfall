    // ------------------------------------------------------------------
    // The faction
    // ------------------------------------------------------------------
    factions: [
        (
            id: "starborn",
            name: "The Synod of the Fallen Star",
            epithet: "They saw it fall first, and have never looked away",
            description: "The star-watching monks of the Synod charted the red star for a hundred years and were the first to walk into the crater while it still smoked. Their paladins, lightbearers and zealots guard its shards as relics, and the light they took from it lifts their kites and arks off the ground long before anyone else's. They are few, devout and expensive: a Synod host wins by holding the crater and refusing to die, healed and shielded, while its flyers strike where walls cannot reach. The Rule of Light forbids powder in the hands of the faithful; their engines and towers may burn it. Where other realms raised gunners, the Synod raised the lens.",
            color: (0.85, 0.2, 0.65),
            traits: [],
            gather_bonus: [("aether", 1.2), ("adamant", 1.25)],
            units: [
                // workers
                "peasant", "engineer",
                // Hearth
