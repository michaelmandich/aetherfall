    // ------------------------------------------------------------------
    factions: [
        (
            id: "dune",
            name: "The Sunspire Caliphate",
            epithet: "Sand-mages and glass-wrights of the deep desert",
            description: "A desert empire ruled from the Sunspire, a tower of sun-fused glass whose astronomers computed the red star's fall years before it came. Sand-mages, calculists and glass-wrights; fast camel riders and scimitar guards; burning mirrors, veils that turn bullets, sonic sandskiffs and a great crawling sand-engine.",
            color: (0.96, 0.62, 0.12),
            traits: [(flag: Dunerunner, applies_to: [Foot, Mounted, Wheeled])],
            gather_bonus: [("silicon", 1.25), ("aether", 1.2)],
            units: [
                // Hearth
                "peasant", "scout_rider", "spearman", "slinger", "archer", "dune_camel_rider",
                // Banner
                "pikeman", "crossbowman", "javelineer", "horse_archer", "battering_ram", "ballista",
                "dune_sun_guard",
