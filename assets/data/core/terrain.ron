        (
            id: "scorched",
            name: "Starfall Scar",
            color: (0.3, 0.27, 0.3),
            height: 0.0,
            passable: [Foot, Mounted, Wheeled, Tracked, Hover],
            speed: 1.0,
            speed_by: [],
