    techs: [

        // ---- Age advancement (town centre, then citadel) ----
        (
            id: "to_banner",
            name: "Raise the Banners",
            description: "Advance to the Banner Age: iron, stone walls, knights, crossbows.",
            age: 1,
            cost: {"food": 500, "wood": 100},
            time: 90,
            researched_at: "town_center",
            effects: [AdvanceAge],
        ),
        (
            id: "to_starfall",
            name: "Seek the Fallen Star",
