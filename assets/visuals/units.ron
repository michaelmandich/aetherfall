// Units drawn with an animated 3D model instead of boxes: unit id -> model
// manifest. Paths are relative to assets/. A manifest is written by the art
// build (see docs/art/peasant.md); a unit whose manifest or model is missing
// or fails to load keeps its boxes. Every *.ron in this folder is merged
// (static.ron, generated by the static art build, lists buildings and
// nodes; see docs/art/static-models.md). Read by af_render at startup.
(
    units: {
        "peasant": "models/peasant/peasant.model.ron",
        // Rigged humanoids (Meshy auto-rig, art/units/<id>/).
        "spearman": "models/spearman/spearman.model.ron",
        "crossbowman": "models/crossbowman/crossbowman.model.ron",
        "starborn_lumen_knight": "models/starborn_lumen_knight/starborn_lumen_knight.model.ron",
        // Rigid units (art/units/<id>/unit.py, KIND = "rigid"): no clips.
        "scout_rider": "models/scout_rider/scout_rider.model.ron",
        "battering_ram": "models/battering_ram/battering_ram.model.ron",
        "clockwork_automaton": "models/clockwork_automaton/clockwork_automaton.model.ron",
        "mech_walker": "models/mech_walker/mech_walker.model.ron",
        "hover_tank": "models/hover_tank/hover_tank.model.ron",
        "sylvan_elder_treant": "models/sylvan_elder_treant/sylvan_elder_treant.model.ron",
    },
)
