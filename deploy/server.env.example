# /etc/aetherfall/server.env: the server's settings (see `af_server --help`).
# Keep this file readable by root only: the service-role key gives full
# access to the Supabase project.

AF_BIND=0.0.0.0:7777
AF_MOTD=Welcome to the Pi

# Ranked play (accounts, ratings) needs all three. Without them the server
# hosts casual rooms only. The URL and anon key are in the Supabase
# dashboard under Project Settings > API; the service-role key is on the
# same page under "service_role" (never share it, never put it in a client).
AF_SUPABASE_URL=https://lzhbaolhanwvancalmfd.supabase.co
AF_SUPABASE_ANON_KEY=sb_publishable_...
AF_SUPABASE_SERVICE_KEY=...

# Accounts sign up with <username>@<this domain>; it never receives mail.
AF_EMAIL_DOMAIN=aetherfall.invalid

# Seconds a match waits for everyone to load before its clock starts.
AF_LOAD_TIMEOUT=20
# Seconds a ranked player may be gone before forfeiting.
AF_FORFEIT_AFTER=60
# A ranked desync voids the match (no rating change); 1 makes the desynced
# player forfeit instead.
AF_DESYNC_FORFEITS=0
